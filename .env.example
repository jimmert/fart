# Copy to /opt/fart/.env on the server. Values are never committed and never logged;
# `fart status` only prints configured / not configured per key.

# --- Solana RPC (Alchemy pay-as-you-go). Leave empty to fall back to the public RPC (no key). ---
RPC_HTTP_URL=
RPC_WSS_URL=
# Hard daily cap on estimated compute units for the RPC source (see config/budget.json cost table).
RPC_DAILY_BUDGET_CU=3000000

# --- PumpPortal public data websocket (no key needed for creates + migrations). ---
PUMPPORTAL_WSS_URL=wss://pumpportal.fun/api/data
# Optional. PumpPortal serves subscribeTokenTrade only to a funded API key. Without a key fart takes
# per-mint trades from the RPC (default). With a key the connection uses ?api-key=<key> (never logged).
PUMPPORTAL_API_KEY=

# --- X (Twitter) API v2, pay-per-use. Empty = social watch disabled. ---
X_BEARER_TOKEN=
# Hard daily cap in USD for all X calls together (default 3.00).
X_DAILY_BUDGET_USD=3.00

# --- Telegram, owner chat only. Both values plus TELEGRAM_NOTIFY_ENABLED=1 are required to send. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=0

# Root directory holding data/, out/, logs/ (defaults to the repository root).
FART_ROOT=/opt/fart
