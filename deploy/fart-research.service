[Unit]
Description=fart research: the weekly run of every pre-registered hypothesis (30 days, or what the database has) and the autopsy
Documentation=file:///opt/fart/app/deploy/DEPLOY.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/fart/venv/bin/python -m fart --quiet research run --hypothesis all --days 30
ExecStart=/opt/fart/venv/bin/python -m fart --quiet research autopsy --days 30
# the first real run of 7 days took 9 m 47 s on the VPS (31 Oct 2026); 30 days and ten hypotheses need room
TimeoutStartSec=5400
Nice=10
# --- hardening (shared host; reads the database read-only, writes only out/research and logs; no network) ---
User=fart
Group=fart
Slice=fart.slice
WorkingDirectory=/opt/fart/app
Environment=FART_ROOT=/opt/fart
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/fart/data /opt/fart/out /opt/fart/logs
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
