# fart website (milestones 8 and 9): kingdegen.dev -> fart-web.service on 127.0.0.1:8792 (loopback only).
#
# Site file for the VPS's shared Caddy 2.6.2 (larp-scanner-https.service), no plugins. Install it where that Caddy can
# read it and import it from /srv/larp-scanner/https/Caddyfile (deploy/DEPLOY.md, "Milestone 8: website"):
#
#   install -D -m 0644 -o root -g root /opt/fart/app/deploy/caddy/fart.caddy /srv/fart/fart.caddy
#   echo 'import /srv/fart/fart.caddy' >> /srv/larp-scanner/https/Caddyfile
#
# (Caddy runs as a DynamicUser and cannot read /opt/fart itself, which is root:fart 0750: importing the file straight
# from /opt/fart/app would make `caddy reload` work from a root shell and the next restart of Caddy fail.)
#
# The application sets the Content-Security-Policy, X-Content-Type-Options, Referrer-Policy, X-Frame-Options and
# Cache-Control on every response itself; Caddy adds HSTS, repeats the three simple ones as defaults (`?`: only when the
# upstream did not send them, e.g. on its own error pages) and hides its Server header. The 64 KB request limit is
# enforced twice: here (request_body) and in the application (431/413).
#
# Milestone 9: only kingdegen.dev. www.kingdegen.dev has no DNS record, so it is left out on purpose (Caddy would otherwise
# keep trying to obtain a certificate for it and log the failures); add it back to the first line when the record exists.
#
# Milestone 12: /api/public/stream is a server-sent-events stream (text/event-stream, chunked). It must reach the browser
# unbuffered and uncompressed: the encoder only compresses the listed content types (text/event-stream is not among them)
# and the stream's reverse_proxy flushes every write at once (flush_interval -1). After `caddy validate`, check with
# `curl -N https://kingdegen.dev/api/public/stream` that the first event arrives within a second (docs/UNVERIFIED.md).

kingdegen.dev {
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type text/markdown*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options nosniff
		?Referrer-Policy no-referrer
		?X-Frame-Options DENY
		-Server
		defer
	}

	@stream path /api/public/stream
	reverse_proxy @stream 127.0.0.1:8792 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:8792
}
