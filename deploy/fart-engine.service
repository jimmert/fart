[Unit]
Description=fart engine: candidate engine v0 (observations only, 15 s loop)
Documentation=file:///opt/fart/app/deploy/DEPLOY.md
After=network-online.target fart-ingest.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/fart/venv/bin/python -m fart --quiet engine
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
# --- hardening (shared host; outbound HTTPS/WSS only; no inbound ports) ---
User=fart
Group=fart
Slice=fart.slice
WorkingDirectory=/opt/fart/app
Environment=FART_ROOT=/opt/fart
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/fart/data /opt/fart/out /opt/fart/logs
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
